# YouTube Content Intelligence Pipeline — Environment Variables
# Copy this file to .env and fill in your values

# === AI Provider (choose one) ===

# Option A: Anthropic (recommended)
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY_HERE

# Option B: OpenAI
# OPENAI_API_KEY=YOUR_OPENAI_API_KEY_HERE

# Which provider to use: "anthropic" or "openai"
AI_PROVIDER=anthropic

# === Optional: Supadata (Tier 4 transcript fallback) ===
# Only needed if free tiers (1-3) consistently fail for your videos
# Sign up at https://supadata.ai to get an API key
# SUPADATA_API_KEY=YOUR_SUPADATA_API_KEY_HERE
